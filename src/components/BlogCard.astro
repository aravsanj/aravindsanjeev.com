---
import { type CollectionEntry } from "astro:content";
import { formatDate } from "../lib/utils";
interface Props { post: CollectionEntry<"blog">; }
const { post } = Astro.props;
---
<article class="border-t border-border py-7 first:border-t-0 first:pt-0">
  <time class="font-sans text-xs text-secondary">{formatDate(post.data.publishedAt)}</time>
  <h2 class="mt-2 text-2xl font-semibold leading-tight tracking-[-0.03em] sm:text-3xl"><a class="hover:text-accent" href={`/${post.slug}`}>{post.data.title}</a></h2>
  <p class="mt-3 max-w-2xl text-secondary leading-relaxed">{post.data.summary}</p>
  {post.data.tags?.length > 0 && <p class="mt-3 font-sans text-xs text-secondary">{post.data.tags.join(" · ")}</p>}
</article>
