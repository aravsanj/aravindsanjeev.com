---
import { getCollection, type CollectionEntry } from "astro:content";
import { formatDate } from "../lib/utils";
interface Props { posts: CollectionEntry<"blog">[]; }
type ProjectEntry = CollectionEntry<"projects">;
const { posts } = Astro.props;
const projects = (await getCollection("projects"))
  .sort((a: ProjectEntry, b: ProjectEntry) => (b.data.priority ?? 0) - (a.data.priority ?? 0))
  .slice(0, 4);
const latestPosts = posts.slice(0, 3);
---
<section class="border-t border-border pt-16">
  <div class="grid gap-20 lg:grid-cols-[1.1fr_0.9fr]">
    <section>
      <div class="mb-8 flex items-baseline justify-between"><h2 class="font-sans text-sm font-semibold text-primary">Selected work</h2><a class="font-sans text-sm text-secondary hover:text-primary" href="/projects">View all →</a></div>
      <div class="divide-y divide-border border-y border-border">
        {projects.map((project) => (
          <article class="py-6 first:pt-5">
            <div class="flex gap-5"><span class="w-10 pt-1 font-sans text-xs text-secondary">{project.data.publishedAt ? new Date(project.data.publishedAt).getFullYear() : ""}</span><div><h3 class="font-sans text-lg font-semibold tracking-tight"><a class="hover:text-accent" href={project.data.url ?? "/projects"} target={project.data.url ? "_blank" : undefined} rel={project.data.url ? "noreferrer" : undefined}>{project.data.title}</a></h3><p class="mt-1 text-secondary leading-relaxed">{project.data.description}</p></div></div>
          </article>
        ))}
      </div>
    </section>
    <section>
      <div class="mb-8 flex items-baseline justify-between"><h2 class="font-sans text-sm font-semibold text-primary">Latest writing</h2><a class="font-sans text-sm text-secondary hover:text-primary" href="/blog">All posts →</a></div>
      <div class="space-y-8">
        {latestPosts.map((post) => <article><time class="font-sans text-xs text-secondary">{formatDate(post.data.publishedAt)}</time><h3 class="mt-2 text-2xl font-semibold leading-tight tracking-[-0.03em]"><a class="hover:text-accent" href={`/${post.slug}`}>{post.data.title}</a></h3><p class="mt-2 leading-relaxed text-secondary">{post.data.summary}</p></article>)}
      </div>
    </section>
  </div>
</section>
