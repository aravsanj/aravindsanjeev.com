---
import Layout from "../layouts/Layout.astro";

const metadata = {
  title: "Contact — Aravind Sanjeev",
  description: "Get in touch for projects, collaborations, or just to say hi.",
};
---

<Layout title={metadata.title} description={metadata.description}>
  <header class="max-w-2xl pb-16 sm:pb-20">
    <p class="font-sans text-sm text-secondary">Contact</p>
    <h1 class="mt-4 text-5xl font-semibold tracking-[-0.05em] text-primary sm:text-7xl">Let’s work together.</h1>
    <p class="mt-7 text-xl leading-relaxed text-secondary">Have a project, an idea, or a role in mind? Send a note and I’ll get back to you soon.</p>
  </header>

  <div class="grid max-w-4xl gap-16 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-20">
    <section aria-labelledby="contact-form-heading">
      <h2 id="contact-form-heading" class="text-2xl font-semibold tracking-[-0.03em] text-primary">Send a message</h2>
      <form id="contact-form" action="https://script.google.com/macros/s/AKfycbywKg0hophDZMU28QdM0Px5PZlcboebKY_NrNO7YkQ_BV-3h4_qgJvhjkWDynzyGE7WSg/exec" method="POST" class="mt-8 space-y-6">
        <div>
          <label for="name" class="block text-sm font-medium text-primary">Name</label>
          <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your name" class="mt-2 block w-full border-b border-border bg-transparent px-0 py-3 text-primary outline-none transition-colors placeholder:text-secondary/70 focus:border-primary" />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-primary">Email</label>
          <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com" class="mt-2 block w-full border-b border-border bg-transparent px-0 py-3 text-primary outline-none transition-colors placeholder:text-secondary/70 focus:border-primary" />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-primary">Message</label>
          <textarea id="message" name="message" rows="5" required placeholder="Tell me a little about what you’re working on." class="mt-2 block w-full resize-none border-b border-border bg-transparent px-0 py-3 text-primary outline-none transition-colors placeholder:text-secondary/70 focus:border-primary"></textarea>
        </div>
        <button type="submit" class="inline-flex items-center border-b border-primary pb-1 text-sm font-medium text-primary transition-colors hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-60">
          Send message <span aria-hidden="true" class="ml-2">→</span>
        </button>
      </form>
      <div id="form-status" class="mt-5 hidden" role="status" aria-live="polite"><p class="text-sm"></p></div>
    </section>

    <aside class="border-t border-border pt-6 lg:border-t-0 lg:border-l lg:pl-8 lg:pt-0">
      <h2 class="text-sm font-semibold text-primary">Prefer email?</h2>
      <p class="mt-3 leading-relaxed text-secondary">You can also reach me directly at</p>
      <a href="mailto:hi@aravindsanjeev.com" class="mt-3 inline-block border-b border-primary pb-0.5 text-primary transition-colors hover:border-accent hover:text-accent">hi@aravindsanjeev.com</a>

      <div class="mt-10">
        <h2 class="text-sm font-semibold text-primary">Book a call</h2>
        <p class="mt-3 leading-relaxed text-secondary">For a project conversation, choose a time that works for you.</p>
        <a href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ3XMK9NOox_TPLSyObRx_nRYu49-PV1f2bGqMqrCOp-vYJdiNP2MfcdKTSxxtfrR3IjO6PeHW9z" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex border-b border-primary pb-0.5 text-sm font-medium text-primary transition-colors hover:border-accent hover:text-accent">Pick a time <span aria-hidden="true" class="ml-2">↗</span></a>
      </div>
    </aside>
  </div>
</Layout>

<script is:inline src="https://www.google.com/recaptcha/api.js?render=6Lesx0IsAAAAAEcCZpemdGpSQFiIr-w8jx_aKa6c"></script>

<script is:inline>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const statusText = status.querySelector('p');
  const SITE_KEY = '6Lesx0IsAAAAAEcCZpemdGpSQFiIr-w8jx_aKa6c';

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button');
      const originalText = button.textContent;

      button.disabled = true;
      button.textContent = 'Sending…';

      try {
        const token = await new Promise((resolve, reject) => {
          grecaptcha.ready(() => {
            grecaptcha.execute(SITE_KEY, { action: 'submit' }).then(resolve).catch(reject);
          });
        });

        const formData = new FormData(form);
        formData.append('g-recaptcha-response', token);
        const response = await fetch(form.action, { method: 'POST', body: formData });
        const data = await response.json();

        if (response.ok && data.result === 'success') {
          status.classList.remove('hidden');
          statusText.textContent = "Thanks — I’ll get back to you soon.";
          statusText.className = 'text-sm text-primary';
          button.textContent = 'Message sent';
          form.reset();
        } else {
          throw new Error(data.error || 'Form submission failed');
        }
      } catch (error) {
        console.error('Submission error:', error);
        status.classList.remove('hidden');
        statusText.textContent = 'There was an error while submitting. Please try emailing me directly.';
        statusText.className = 'text-sm text-secondary';
        button.disabled = false;
        button.textContent = originalText;
      }
    });
  }
</script>
