---
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
type ProjectEntry = CollectionEntry<"projects">;
const projects = (await getCollection("projects")).sort((a: ProjectEntry, b: ProjectEntry) => {
  const priority = (b.data.priority ?? 0) - (a.data.priority ?? 0);
  return priority || new Date(b.data.publishedAt ?? 0).valueOf() - new Date(a.data.publishedAt ?? 0).valueOf();
});
---
<Layout title="Portfolio — Aravind Sanjeev" description="Selected work by Aravind Sanjeev.">
  <header class="max-w-2xl pb-20"><p class="font-sans text-sm text-secondary">Portfolio</p><h1 class="mt-4 text-5xl font-semibold tracking-[-0.05em] sm:text-7xl">Selected work.</h1><p class="mt-7 text-xl leading-relaxed text-secondary">A selection of digital products and experiences I’ve helped shape—from initial idea to a finished, usable thing.</p></header>
  <section class="max-w-4xl divide-y divide-border border-y border-border">
    {projects.map((project) => {
      const year = project.data.publishedAt ? new Date(project.data.publishedAt).getFullYear() : null;
      return <article class="grid gap-4 py-9 sm:grid-cols-[5rem_1fr]"><p class="pt-1 font-sans text-sm text-secondary">{year}</p><div><h2 class="text-3xl font-semibold leading-tight tracking-[-0.035em]"><a class="hover:text-accent" href={project.data.url ?? "#"} target={project.data.url ? "_blank" : undefined} rel={project.data.url ? "noreferrer" : undefined}>{project.data.title}{project.data.url && <span class="ml-2 font-sans text-base font-normal text-secondary">↗</span>}</a></h2><p class="mt-3 max-w-2xl text-lg leading-relaxed text-secondary">{project.data.description}</p>{project.data.tags?.length > 0 && <p class="mt-4 font-sans text-xs text-secondary">{project.data.tags.join(" · ")}</p>}</div></article>;
    })}
  </section>
</Layout>
