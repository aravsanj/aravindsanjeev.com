---
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";
const posts = (await getCollection("blog"))
  .filter((post: CollectionEntry<"blog">) => !post.data.isDraft)
  .sort((a, b) => new Date(b.data.publishedAt).valueOf() - new Date(a.data.publishedAt).valueOf());
---
<Layout title="Blog — Aravind Sanjeev" description="Writing about engineering, AI, and building for the web.">
  <header class="max-w-2xl pb-20"><p class="font-sans text-sm text-secondary">Blog</p><h1 class="mt-4 text-5xl font-semibold tracking-[-0.05em] sm:text-7xl">Notes on making things.</h1><p class="mt-7 text-xl leading-relaxed text-secondary">Writing about engineering, AI, product, and the process of building for the web.</p></header>
  <section class="max-w-3xl"><div class="border-b border-border">{posts.map((post) => <BlogCard post={post} />)}</div></section>
</Layout>
